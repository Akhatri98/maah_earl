# Copy this file to .env and fill in real values. Never commit .env.

# --- Onshape (Stage 1: Ingestion) ---
# API keys from https://dev-portal.onshape.com/keys
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com
# Document / workspace to read mate structure and "where used" refs from
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=

# --- SkyCiv (Stage 3: Trusted artifact) ---
# https://skyciv.com/api/
SKYCIV_API_USERNAME=
SKYCIV_API_KEY=
# Where escalation (and scripts/skyciv_smoke.py) save downloaded report PDFs
SKYCIV_REPORT_DIR=artifacts/reports

# --- Gmail (Stage 4: Sharing) ---
# OAuth client credentials for the Gmail API (send-only scope)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
GMAIL_NOTIFY_RECIPIENT=

# --- LLM (Stage 2 orchestration) ---
META_MUSE_KEY=
# OpenAI-compatible chat-completions endpoint and model used by the analysis
# planner (earl.analysis.orchestrator). The planner only proposes which load
# case to lead with; it can never change a verdict. Defaults shown.
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.1

# The same key and endpoint also drive the Sprint 5A eval's BASELINE AGENT
# (earl.eval.llm.MuseToolClient) -- a tool-using LLM with the same PyNite
# access as the system but no graph traversal and no enforced threshold. It is
# what the dropped-domino number is measured against, so it deliberately runs
# on the same model as the rest of the pipeline: a weaker baseline would make
# the gap look like a model-quality artefact rather than a structural one.
#   scripts/run_eval.py --agents system            needs nothing (offline)
#   scripts/run_eval.py --agents system,baseline   needs META_MUSE_KEY
#   scripts/run_eval.py --replay <dir>             replays a recorded run

# --- Biject / decision logic ---
# Safety factor below this can never be auto-approved (see plan.md)
SAFETY_FACTOR_THRESHOLD=1.0

# --- ngrok (demo tunnel) ---
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# Used only to expose a local endpoint during the demo; no pipeline stage
# reads it, and nothing merges or sends based on it.
NGROK_AUTHTOKEN=
